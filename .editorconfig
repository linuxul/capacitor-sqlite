root = true

# Only Kotlin is configured here. Prettier also reads this file, so a catch-all section would change how
# the JavaScript and TypeScript sources are formatted.
[*.{kt,kts}]
ktlint_code_style = android_studio
indent_size = 4
max_line_length = 140
# The source packages ...sqlite.SQLite and ...sqlite.SQLite.ImportExportJson predate the Kotlin port and keep their names.
ktlint_standard_package-name = disabled
